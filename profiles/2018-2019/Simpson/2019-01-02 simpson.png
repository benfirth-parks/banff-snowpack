iz.org/niviz/dist/" ng-click="$parent.$parent.showmodal(true);" class="ng-binding">Edit profile (Modal)</a></li><!-- end ngIf: $parent.showeditor --><li class="divider"></li><li><a href="https://niviz.org/niviz/dist/" ng-click="print()" class="ng-binding">Print</a></li><li class="divider"></li><li><a href="https://niviz.org/niviz/dist/" ng-click="save(&#39;SVG&#39;)" class="ng-binding">Export SVG</a></li><li><a href="https://niviz.org/niviz/dist/" ng-click="save(&#39;PNG&#39;)" class="ng-binding">Export PNG</a></li><li><a href="https://niviz.org/niviz/dist/" ng-click="save(&#39;CAAML5&#39;)" class="ng-binding">Export CAAML5 (legacy)</a></li><li><a href="https://niviz.org/niviz/dist/" ng-click="save(&#39;CAAML&#39;)" class="ng-binding">Export CAAML6</a></li><li><a href="https://niviz.org/niviz/dist/" ng-click="save(&#39;JSON&#39;)" class="ng-binding">Export JSON</a></li></ul></li></ul><h1 class="title-heading ng-binding">Profile View - </h1></div><svg class="body" id="canvas" style="width: 900px; height: 808px; margin: 5px;" width="863px" height="1220.45px"><g></g><g></g><g></g><g></g><g><rect x="24" y="0" width="875" height="150" fill="none" stroke="#000000" transform="matrix(1,0,0,1,0.5,0.5)" style=""></rect><text x="29" y="18" fill="#000000" style="font-size: 12px; text-anchor: start; font-family: Helvetica, Arial; font-weight: bold; cursor: pointer;">Location: simpson</text><text x="29" y="36" fill="#000000" style="font-size: 12px; text-anchor: start; font-family: Helvetica, Arial;">Observer: jpk</text><text x="29" y="90" fill="#000000" style="font-size: 12px; text-anchor: start; font-family: Helvetica, Arial;">Snow height: 102 cm</text><text x="320.6666666666667" y="36" fill="#000000" style="font-size: 12px; text-anchor: start; font-family: Helvetica, Arial;">Altitude: 1900 m</text><text x="320.6666666666667" y="54" fill="#000000" style="font-size: 12px; text-anchor: start; font-family: Helvetica, Arial;">Exposition: flat / Slope: 0°</text><text x="320.666666666