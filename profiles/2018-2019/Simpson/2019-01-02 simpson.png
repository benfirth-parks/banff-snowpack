 class="form-group form-group-sm row"><label class="col-sm-3 control-label">{{ '_pe_temp' | t : lang}}</label><div class="col-sm-4"><div class="input-group input-group-sm"><span class="input-group-addon">&ndash;</span><input class="form-control" type="number" ng-model="layer.value" required min="0" max="99" placeholder="Temperature" step="0.0000000001"><span class="input-group-addon">°C</span></div></div></div><div class="row" ng-hide="true"><button class="btn btn-primary" type="submit" ng-disabled="editform[$index].$pristine || editform[$index].$invalid"></button></div></form><div class="btn-toolbar pull-left"><button class="btn btn-sm btn-default" type="button" ng-click="remove(layer.index, extrai);">{{ '_pe_btn_delete_layer' | t : lang }}</button><button class="btn btn-sm btn-default" type="button" ng-if="!meta[extrai].pointprofile &amp;&amp;undefined" ng-click="insert(layer.index, extrai);">{{ '_pe_btn_insert_layer' | t : lang }}</button></div><div class="btn-toolbar pull-right"><button class="btn btn-sm btn-default" type="button" ng-click="cancel(layer, extrai); editform[$index].$setPristine();" ng-disabled="editform[$index].$pristine">{{ '_pe_btn_cancel' | t : lang }}</button><button class="btn btn-sm btn-primary" type="submit" ng-click="save(layer, extrai); editform[$index].$setPristine();" ng-disabled="editform[$index].$pristine || editform[$index].$invalid">{{ '_pe_btn_apply' | t : lang }}</button></div></div><br></div></uib-accordion></div></div></div></script><script type="text/ng-template" id="profile-editor.html"><div class="editor" id="editor" style="width: 100%; min-height: 90%; max-height: 90%; overscroll-y: scroll; height: 95%; margin: 5px; min-width: 520px;max-width: 520px;margin: 0;"><uib-accordion class="profile-selector" close-others="true"><div class="panel-default" uib-accordion-group is-open="selectView.isOpen"><uib-accordion-heading style="width: 100%;"><div class="clickable"><div class="profile-selector-title">Profile Editor -&nbsp;<span class="active-selector-title">{{ $parent.$parent.view.name | t : lang}}</span></div><i class="glyphicon glyphicon-remove pull-right" ng-click="$parent.$parent.$parent.$parent.showeditor(false)"></i><i class="pull-right glyphicon" ng-class="{'glyphicon-chevron-down': selectView.isOpen, 'glyphicon-chevron-right': !selectView.isOpen}"></i></div></uib-accordion-heading><div class="accordion-body"><div class="panel selector-option" ng-repeat="view in views track by $index" ng-click="setView($index); selectView.isOpen = false;" ng-class="{'active-selector-title': view.id === $parent.view.id}"><span ng-bind="view.name | t : lang"></span></div></div></div></uib-accordion><div class="profile-pane"><edit-metadata ng-if="view.id === 1" profile="current" station="profile" callback="clone_all"></edit-metadata><edit-stratprofile class="multiprofile" ng-if="view.id === 2" profile="current" station="profile" callback="repaint" collapsible="true"></edit-stratprofile><edit-tempprofile class="multiprofile" ng-if="view.id === 3" collapsible="true" profile="current" station="profile" callback="repaint" varname="'temperature'"></edit-tempprofile><edit-densityprofile class="multiprofile" ng-if="view.id === 4" collapsible="true" profile="current" station="profile" callback="repaint" varname="'density'"></edit-densityprofile><edit-stbprofiles ng-if="view.id === 5" collapsible="true" profile="current" station="profile" callback="repaint"></edit-stbprofiles><edit-hardnessprofiles ng-if="view.id === 6" collapsible="true" profile="current" station="profile" callback="repaint"></edit-hardnessprofiles><edit-lwcprofile class="multiprofile" ng-if="view.id === 7" collapsible="true" profile="current" station="profile" callback="repaint" varname="'lwc'"></edit-lwcprofile><edit-ssaprofile class="multiprofile" ng-if="view.id === 8" collapsible="true" profile="current" station="profile" callback="repaint" varname="'ssa'"></edit-ssaprofile></div></div></script><script type="text/ng-template" id="edit-insert-layer.html"><div class="modal-header"><h4 class="modal-title">{{ '_pe_btn_insert_layer' | t : lang }}</h4></div><form class="form-horizontal" name="modalILForm"><div class="modal-body"><div class="form-group form-group-sm row"><label class="col-sm-3 control-label">{{ '_pe_position' | t : lang }}</label><div class="col-sm-4"><div class="input-group input-group-sm"><input class="form-control" type="number" ng-model="data.top" required min="{{ layer.min }}" max="{{ layer.max }}" placeholder="{{ '_pe_top' | t : lang }}" step="0.0000000001"><span class="input-group-addon">cm</span></div></div><div class="col-sm-4" ng-if="!meta[undefined].pointprofile"><div class="input-group input-group-sm"><input class="form-control" type="number" ng-model="data.bottom" leq-than="data.top" required min="{{ layer.min }}" max="{{ layer.max }}" placeholder="{{ '_pe_bottom' | t : lang }}" step="0.0000000001"><span class="input-group-addon">cm</span></div></div></div></div><div class="modal-footer settings"><button class="btn btn-sm btn-default" type="button" ng-click="cancel()">{{ '_pe_btn_cancel' | t : lang }}</button><button class="btn btn-sm btn-primary" type="submit" ng-click="save()" ng-disabled="modalILForm.$invalid">{{ '_pe_btn_insert_layer' | t : lang }}</button></div></form></script><script type="text/ng-template" id="timeliner.html"><div class="header"><a class="close" type="button" aria-hidden="true" ng-click="close()">&times;</a><ul class="nav navbar-nav pull-right"><li uib-dropdown><a href="#" uib-dropdown-toggle data-toggle="dropdown" role="button" aria-expanded="false">&#9776;</a><ul class="dropdown-menu dropdown-menu-right" role="menu" uib-dropdown-menu><li ng-repeat="parameter in parameters"><a href ng-click="properties(parameter.lookup)">{{parameter.name}}</a></li><li class="divider"></li><li ng-if="togglesoil"><a href ng-click="showsoil(false);" ng-show="soil">{{ 'hide_soil_layers' | t : lang}}</a><a href ng-click="showsoil(true);" ng-show="!soil">{{ 'show_soil_layers' | t : lang}}</a></li><li class="divider" ng-if="togglesoil"></li><li><a href ng-click="$parent.maximize('timeline');" ng-show="!$parent.tmax">{{ 'Maximize' | t : lang}}</a><a href ng-click="$parent.overlap();" ng-show="$parent.tmax">{{ 'overlap_profile' | t : lang }}</a></li><li class="divider"></li><li><a href ng-click="opentimeseries()" ng-class="{hidelink: timeline.meteo}">{{ 'add_time_series' | t : lang }}&hellip;</a></li><li><a href ng-click="extract()">{{ 'extract_time_series' | t : lang}}&hellip;</a></li><li><a href ng-click="snow_height_settings()">{{ 'snow_height' | t : lang}}&hellip;</a></li><li class="divider"></li><li><a href ng-click="print()">{{ 'Print' | t : lang}}</a></li><li class="divider"></li><li><a href ng-click="save('SVG')">{{ 'export_svg' | t : lang }}</a></li><li><a href ng-click="save('PNG')">{{ 'export_png' | t : lang }}</a></li><li><a href ng-click="save('JSON')">{{ 'export_json' | t : lang }}</a></li></ul></li></ul><h1>Timeline View - {{station.filename}}</h1></div><svg class="body" id="canvas" style="width: 100%; height: 100%; margin: 5px;" spinner="processing"></svg></script><script type="text/ng-template" id="meteographer.html"><div class="header"><a class="close" type="button" aria-hidden="true" ng-click="close()">&times;</a><ul class="nav navbar-nav pull-right"><li uib-dropdown><a href="#" uib-dropdown-toggle data-toggle="dropdown" role="button" aria-expanded="false">&#9776;</a><ul class="dropdown-menu dropdown-menu-right" role="menu" uib-dropdown-menu><li><a href ng-click="print()">{{ 'Print' | t : lang}}</a></li><li class="divider"></li><li><a href ng-click="save('CSV')">{{ 'export_csv' | t : lang }}</a></li><li><a href ng-click="save('SVG')">{{ 'export_svg' | t : lang }}</a></li><li><a href ng-click="save('PNG')">{{ 'export_png' | t : lang }}</a></li><li><a href ng-click="save('JSON')">{{ 'export_json' | t : lang }}</a></li></ul></li></ul><h1>Time series - {{meteo.filename}}</h1><ui-select class="form-control" ng-model="value" multiple on-select="set(value)" on-remove="set(value)"><ui-select-match>{{$item}}</ui-select-match><ui-select-choices repeat="item in parameters | filter:$select.search"><span ng-bind="item"></span></ui-select-choices></ui-select></div><svg class="body" id="canvas" style="width: 860px; height: 100%; overflow: hidden; position: relative;" spinner="processing"></svg></script><script type="text/ng-template" id="visualizer.html"><div class="visualizer" style="height: 100%;"><div class="fenestra" meteographer meteo="timeline.meteo" ng-if="timeline.meteo" width="500" cart="true" on-close="deregister(timeline)" lang="lang"></div><div class="fenestra" timeliner timeline="timeline" on-close="destroy('timelines', $index)" width="twidth" ng-hide="pmax" lang="lang"></div><div class="fenestra" profiler profile="timeline" miniature="miniature" width="pwidth" ng-hide="tmax" lang="lang"></div><div class="fenestra" meteographer meteo="extracted.meteo" ng-if="extracted.meteo" width="twidth" on-close="$parent.extracted.meteo = null;" lang="lang"></div></div></script><script type="text/ng-template" id="pvisualizer.html"><div class="pvisualizer" style="height: 100%;"><div class="fenestra prof" profiler profile="profile" on-close="destroy('profiles', $index)" lang="lang"></div><div class="fenestra profile-editor" profile-editor profile="profile" ng-if="editor" on-close="destroy('profiles', $index)" lang="lang"></div></div></script><script type="text/ng-template" id="info.html"><div class="info"><div class="panel panel-default" ng-show="false"><div class="panel-heading"><h3 class="panel-title">File</h3></div><div class="panel-body"><dl class="dl-horizontal"><dt>Filename</dt><dd>{{ data.filename }}</dd><dt>Size</dt><dd>{{ data.size | number }}</dd><dt>Type</dt><dd>{{ data.type }}</dd><dt>Last modified</dt><dd>{{ data.modified | date }}</dd></dl></div></div></div></script><script type="text/ng-template" id="console.html"><div class="console"><div uib-alert ng-repeat="alert in alerts | limitTo:10" ng-class="'alert-' + (alert.type || 'warning')" close="dismiss($index)">{{alert.message}}</div></div></script><script type="text/ng-template" id="template/alert/alert.html"><div class="uib-alert" ng-class="['alert-' + (type || 'warning'), closeable ? 'alert-dismissable' : null]" role="alert"><button class="close" ng-show="closeable" type="button" ng-click="close()"><span aria-hidden="true">&times;</span></button><div class="div" ng-transclude></div></div></script><script type="text/ng-template" id="template/modal/backdrop.html"><div class="modal-backdrop" modal-animation-class="fade" modal-in-class="in" ng-style="{'z-index': 1040 + (index &amp;&amp; 1 || 0) + index*10}"></div></script><script type="text/ng-template" id="template/modal/window.html"><div class="modal" modal-render="{{$isRendered}}" tabindex="-1" role="dialog" modal-animation-class="fade" modal-in-class="in" ng-style="{'z-index': 1050 + index*10, display: 'block'}" ng-click="close($event)"><div class="modal-dialog" ng-class="size ? 'modal-' + size : ''"><div class="modal-content" modal-transclude></div></div></div></script><script type="text/ng-template" id="template/tabs/tab.html"><li ng-class="{active: active, disabled: disabled}"><a href ng-click="select()" tab-heading-transclude>{{heading}}</a></li></script><script type="text/ng-template" id="template/tabs/tabset.html"><div><ul class="nav nav-{{type || 'tabs'}}" ng-class="{'nav-stacked': vertical, 'nav-justified': justified}" ng-transclude></ul><div class="tab-content"><div class="tab-pane" ng-repeat="tab in tabs" ng-class="{active: tab.active}" tab-content-transclude="tab"></div></div></div></script><script async="" defer="" src="./2019-01-02 simpson_files/js"></script></body></html>