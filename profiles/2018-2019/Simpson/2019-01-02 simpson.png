select-match><ui-select-choices class="gs-choice" repeat="choice in niviz.Value.GrainShape.options | filter: {id: ($select.search != null &amp;&amp; $select.search || $select.selected.id)} track by $index"><span ng-bind="choice.key" style="font-family: snowsymbolsiacs;"></span>&nbsp;&nbsp;&nbsp; {{ choice.id }}</ui-select-choices></ui-select></div><div class="col-sm-4"><ui-select ng-model="layer.grainform.secondary" theme="bootstrap" uib-tooltip="{{ '_pe_strat_tt_secondary' | t : lang }}" tooltip-placement="top" reset-search-input="true" title="" ng-disabled="!layer.grainform.primary.id"><ui-select-match placeholder="Secondary" allow-clear="true"><span style="font-family: snowsymbolsiacs; width: auto;">{{ $select.selected.key }}</span>&nbsp;&nbsp;&nbsp; {{ $select.selected.id }}</ui-select-match><ui-select-choices class="gs-choice" repeat="choice in niviz.Value.GrainShape.options | filter: {id: ($select.search != null &amp;&amp; $select.search || $select.selected.id)} track by $index"><span ng-bind="choice.key" style="font-family: snowsymbolsiacs;"></span>&nbsp;&nbsp;&nbsp; {{ choice.id }}</ui-select-choices></ui-select></div></div><div class="form-group form-group-sm row"><label class="col-sm-3 control-label">{{ '_pe_strat_grainsize' | t : lang }}</label><div class="col-sm-4"><div class="input-group input-group-sm"><input class="form-control" type="number" ng-model="layer.grainsize.avg" min="0.001" max="100" placeholder="Average" step="0.001"><span class="input-group-addon">mm (avg)</span></div></div><div class="col-sm-4"><div class="input-group input-group-sm"><input class="form-control" type="number" ng-model="layer.grainsize.max" min="0.001" max="100" placeholder="Max" step="0.001" bigger-than="layer.grainsize.avg"><span class="input-group-addon">mm (max)</span></div></div></div><div class="form-group form-group-sm row"><label class="col-sm-3 control-label">{{ '_pe_comment' | t : lang }}</label><div class="col-sm-9"><input class="form-control" type="text" ng-model="layer.comments" placeholder="{{ '_pe_comment' | t : lang }}"></div></div><div class="row" ng-hide="true"><button class="btn btn-primary" type="submit" ng-disabled="editform[$index].$pristine || editform[$index].$invalid"></button></div></form><div class="btn-toolbar pull-left"><button class="btn btn-sm btn-default" type="button" ng-click="remove(layer.index, $index);">{{ '_pe_btn_delete_layer' | t : lang }}</button><button class="btn btn-sm btn-default" type="button" ng-if="!meta[$index].pointprofile &amp;&amp;true" ng-click="insert(layer.index, $index);">{{ '_pe_btn_insert_layer' | t : lang }}</button></div><div class="btn-toolbar pull-right"><button class="btn btn-sm btn-default" type="button" ng-click="cancel(layer, $index); editform[$index].$setPristine();" ng-disabled="editform[$index].$pristine">{{ '_pe_btn_cancel' | t : lang }}</button><button class="btn btn-sm btn-primary" type="submit" ng-click="save(layer, $index); editform[$index].$setPristine();" ng-disabled="editform[$index].$pristine || editform[$index].$invalid">{{ '_pe_btn_apply' | t : lang }}</button></div></div><br></div></uib-accordion></div></div></script><script type="text/ng-template" id="add-ct.html"><div class="container" ng-form="densityaddforms[$index]"><form class="form-horizontal" role="form" name="$parent.editform" ng-submit="addlayer(layer[$index], $index);"><div class="form-group form-group-sm row" ng-if="!layer.value.nofailure"><label class="col-sm-3 control-label">{{ '_pe_position' | t : lang }}</label><div class="col-sm-5"><div class="input-group input-group-sm"><input class="form-control top-value" type="number" ng-model="layer[$index].top" required ng-change="compute(layer[$index]);" min="-10000" max="10000" placeholder="{{ '_pe_top' | t : lang }}" step="0.0000000001"><span class="input-group-addon">cm</span></div></div></div><div class="form-group form-group-sm row" ng-if="!layer[$index].value.nofailure"><label class="col-sm-3 control-label">{{ 'Test Score' | t : lang}}</labe