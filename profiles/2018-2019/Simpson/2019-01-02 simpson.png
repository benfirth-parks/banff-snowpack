</script><!--<base href="/niviz/dist/">--><base href="."><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="The goal of niViz is to interactively generate a variety of plots from either measured or simulated snow profiles in a web browser either online or offline"><meta name="license" content="This software is available under GNU Affero General Public License, see www.gnu.org"><title>niViz: Interactive Snow Profiles Visualizer</title><link rel="stylesheet" href="./2019-01-02 simpson_files/application-9b6d3422ceb25cff2b3431fe56bb7731.css"><script src="./2019-01-02 simpson_files/application-626a23d09847a51287e23bc9d12a81cd.js.download"></script><style type="text/css"></style><script type="text/javascript" charset="UTF-8" src="./2019-01-02 simpson_files/common.js.download"></script><script type="text/javascript" charset="UTF-8" src="./2019-01-02 simpson_files/util.js.download"></script></head><body ng-app="niviz" ng-controller="NivizController" ng-strict-di="" class="ng-scope"><header><nav class="navbar navbar-default navbar-static-top ng-scope" ng-controller="MenuController" role="navigation" spinner="parsing"><div class="container-fluid"><div class="navbar-header"><button class="navbar-toggle" ng-click="collapsed = !collapsed"><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><span class="navbar-brand"><a target="_blank" href="https://niviz.org/">niViz</a></span></div><div class="collapse navbar-collapse" collapse="collapsed"><ul class="nav navbar-nav"><li uib-dropdown="" class="dropdown" style=""><a href="https://niviz.org/niviz/dist/" uib-dropdown-toggle="" ui-sref="main" class="ng-binding dropdown-toggle" aria-haspopup="true" aria-expanded="false">File&nbsp;<span class="caret"></span></a><ul class="dropdown-menu" role="menu" uib-dropdown-menu=""><li><a href="https://niviz.org/niviz/dist/" ng-click="create()" class="ng-binding">Create new profile</a></li><li class="divider"></li><li><a href="https://niviz.org/niviz/dist/" ng-click="open()" class="ng-binding">Open profile</a></li><li><a href="https://niviz.org/niviz/dist/" ng-click="open()" class="ng-binding">Open timeline</a></li><li><a href="https://niviz.org/niviz/dist/" ng-click="open()" class="ng-binding">Open timeseries</a></li><li class="divider"></li><li><a href="https://niviz.org/niviz/dist/" ng-click="openLocalStorage()" class="ng-binding">Open from local storage</a></li></ul></li><!-- ngIf: timelines.length || meteos.length > 1 --><li><a href="https://niviz.org/niviz/dist/" ng-click="settings()" class="ng-binding">Settings</a></li><li uib-dropdown="" class="dropdown"><a href="https://niviz.org/niviz/dist/" uib-dropdown-toggle="" ui-sref="main" class="ng-binding dropdown-toggle" aria-haspopup="true" aria-expanded="false">Help&nbsp;<span class="caret"></span></a><ul class="dropdown-menu" role="menu" uib-dropdown-menu=""><li><a ui-sref="help.contents" class="ng-binding" href="https://niviz.org/niviz/dist/help/contents">Help</a></li><li><a target="_blank" href="https://niviz.org/" class="ng-binding">Homepage</a></li><li><a target="_blank" href="http://models.slf.ch/p/niviz/issues" class="ng-binding">Report issues</a></li></ul></li></ul></div></div></nav></header><!-- uiView: --><div ui-view="" class="ng-scope"><div console="" class="ng-scope"><div class="console"><!-- ngRepeat: alert in alerts | limitTo:10 --></div></div><!-- ngIf: !timelines.length && !profiles.length && !meteos.length --><main class="container-fluid ng-scope"><!-- ngRepeat: timeline in timelines --><!-- ngRepeat: profile in profiles --><div pvisualizer="" ng-repeat="profile in profiles" class="ng-scope" style=""><div class="pvisualizer" style="height: 100%;"><div class="fenestra prof ng-isolate-scope" profiler="" profile="profile" on-close="destroy(&#39;profiles&#39;, $index)" lang="lang" style="height: 860px; width: 922px;"><div class="header"><a class="close" type="button" aria-hidden="true" ng-click=