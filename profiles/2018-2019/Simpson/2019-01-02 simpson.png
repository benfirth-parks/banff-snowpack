eration' | t : lang}}</label><div class="col-sm-9"><input class="form-control" type="text" ng-model="pm.operation_gmlid" ng-minlength="2" uib-tooltip="{{ '_pe_meta_id_operation_tt' | t : lang }}" tooltip-placement="bottom" placeholder="{{ '_pe_meta_id_operation' | t : lang}}" required></div></div><div class="row" ng-hide="true"><button class="btn btn-primary" type="submit" id="submit" ng-click="savemeta(metaforms);" ng-disabled="metaforms.$invalid || metaforms.$pristine"></button></div></form></div></div></uib-accordion></div></div></script><script type="text/ng-template" id="add-stratigraphy.html"><div class="container" ng-form="strataddforms[$index]"><form class="form-horizontal" role="form" name="$parent.editform" ng-submit="status.showaddlayer = !!newlayer.bottom; addlayer(newlayer);"><div class="form-group form-group-sm row"><label class="col-sm-3 control-label">{{ '_pe_position' | t : lang}}</label><div class="col-sm-4"><div class="input-group input-group-sm"><input class="form-control top-value" type="number" ng-model="newlayer.top" required ng-change="compute(newlayer);" min="-10000" max="10000" placeholder="{{ '_pe_top' | t : lang}}" step="0.0000000001"><span class="input-group-addon">cm</span></div></div><div class="col-sm-4"><div class="input-group input-group-sm"><input class="form-control bottom-value" type="number" ng-model="newlayer.bottom" leq-than="newlayer.top" required ng-change="compute(newlayer);" min="-10000" max="10000" placeholder="{{ '_pe_bottom' | t : lang}}" step="0.0000000001"><span class="input-group-addon">cm</span></div></div></div><div class="form-group form-group-sm row"><label class="col-sm-3 control-label">{{ '_pe_strat_wetness_hhi' | t : lang}}</label><div class="col-sm-4"><ui-select ng-model="newlayer.wetness" theme="bootstrap" reset-search-input="true" uib-tooltip="{{ '_pe_strat_tt_wetness' | t : lang }}" tooltip-placement="top"><ui-select-match placeholder="θ" allow-clear="true">{{ $select.selected }}</ui-select-match><ui-selec