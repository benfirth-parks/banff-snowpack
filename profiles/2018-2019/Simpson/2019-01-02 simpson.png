gs-choice" repeat="choice in niviz.Value.GrainShape.options | filter: {id: ($select.search != null &amp;&amp; $select.search || $select.selected.id)} track by $index"><span ng-bind="choice.key" style="font-family: snowsymbolsiacs;"></span>&nbsp;&nbsp;&nbsp; {{ choice.id }}</ui-select-choices></ui-select></div></div><div class="form-group form-group-sm row"><label class="col-sm-3 control-label">{{ '_pe_strat_grainsize' | t : lang }}</label><div class="col-sm-4"><div class="input-group input-group-sm"><input class="form-control" type="number" ng-model="newlayer.grainsize.avg" min="0.001" max="100" placeholder="Average" step="0.001"><span class="input-group-addon">mm (avg)</span></div></div><div class="col-sm-4"><div class="input-group input-group-sm"><input class="form-control" type="number" ng-model="newlayer.grainsize.max" min="0.001" max="100" placeholder="Max" step="0.001" bigger-than="newlayer.grainsize.avg"><span class="input-group-addon">mm (max)</span></div></div></div><div class="form-group form-group-sm row"><label class="col-sm-3 control-label">{{ '_pe_comment' | t : lang }}</label><div class="col-sm-9"><input class="form-control" type="text" ng-model="newlayer.comments" placeholder="{{ '_pe_comment' | t : lang }}"></div></div><div class="row" ng-hide="true"><button class="btn btn-primary" type="submit" ng-disabled="$parent.editform.$pristine || $parent.editform.$invalid"></button></div></form><div class="btn-toolbar btn-toolbar-sm pull-right"><button class="btn btn-sm btn-default" type=" button" ng-click="clear(0);">{{ '_pe_btn_clear' | t : lang }}</button><button class="btn btn-sm btn-primary" type="submit" ng-click="status.showaddlayer = !!newlayer.bottom; addlayer(newlayer);" ng-disabled="editform.$pristine || editform.$invalid">{{ '_pe_btn_save_meas' | t : lang }}</button></div></div></script><script type="text/ng-template" id="edit-stratprofile.html"><div uib-collapse="status.iscollapsed"><div class="scrollable-container"><div class="panel panel-default panel-profile"><div class="panel-body panel-btn-bar"><div class="btn-toolbar btn-toolbar-sm pull-right"><button class="btn btn-sm btn-default" ng-click="status.showaddlayer = !status.showaddlayer;"><span class="glyphicon glyphicon-plus"></span><span>&nbsp;{{ '_pe_btn_add_layer' | t : lang }}</span></button></div></div></div><add-stratigraphy ng-if="status.showaddlayer || !collapsible"></add-stratigraphy><uib-accordion close-others="false"><div class="panel-default" uib-accordion-group ng-repeat="layer in cloneSP | orderBy: '-index'" is-open="isopened[$index]" id="{{'stratlayer' +$index}}"><uib-accordion-heading style="width: 100%;" ng-form="editform[$index]"><div class="clickable" ng-click="cancel(layer);"><div class="layer-header"><div class="accordion-label">{{layer.top}} &ndash; {{layer.bottom}} cm</div><div class="details-to"><span>&nbsp;&nbsp;{{layer.hardness}}&nbsp;</span><div class="symbol">{{layer.grainshape}}</div><span class="label label-danger" ng-show="profile &amp;&amp; editform[$index] !== undefined &amp;&amp; editform[$index].$invalid">Error</span><span class="label label-warning" ng-show="profile &amp;&amp; editform[$index] !== undefined &amp;&amp; !editform[$index].$pristine">Changed</span><span class="label label-info" ng-show="layer.overlapping">Overlapping</span></div></div><i class="pull-right glyphicon" ng-class="{'glyphicon-chevron-down': isopened[$index], 'glyphicon-chevron-right': !isopened[$index]}"></i></div></uib-accordion-heading><div class="accordion-body" ng-if="isopened[$index]"><form class="form-horizontal" role="form" name="editform[$index]" ng-submit="save(layer); editform[$index].$setPristine();"><div class="form-group form-group-sm row"><label class="col-sm-3 control-label">{{ '_pe_position' | t : lang}}</label><div class="col-sm-4"><div class="input-group input-group-sm"><input class="form-control top-value" type="number" ng-model="layer.top" required ng-change="compute(layer);" min="-10000" max="10000" placeholder="{{ '_pe_t