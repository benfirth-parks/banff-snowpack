<caaml:snowProfileResultsOf>
  <caaml:SnowProfileMeasurements dir="top down">
    <caaml:profileDepth uom="cm">56</caaml:profileDepth>
    <caaml:skyCond>OVC</caaml:skyCond>
    <caaml:precipTI>-SN</caaml:precipTI>
    <caaml:airTempPres uom="degC">-3.5</caaml:airTempPres>
    <caaml:hS>
      <caaml:Components>
        <caaml:snowHeight uom="cm">56</caaml:snowHeight>
      </caaml:Components>
    </caaml:hS>
    <caaml:hN24>
      <caaml:Components>
        <caaml:snowHeight uom="cm">6</caaml:snowHeight>
      </caaml:Components>
    </caaml:hN24>
    <caaml:surfFeatures>
      <caaml:Components>
        <caaml:surfRoughness>rsm</caaml:surfRoughness>
      </caaml:Components>
    </caaml:surfFeatures>
    <caaml:stratProfile>
      <caaml:Layer>
        <caaml:comment>Compression Test: no significant shears</caaml:comment>
        <caaml:depthTop uom="cm">0</caaml:depthTop>
        <caaml:thickness uom="cm">6</caaml:thickness>
        <caaml:grainFormPrimary>DF</caaml:grainFormPrimary>
        <caaml:grainSize uom="mm">
          <caaml:Components>
            <caaml:avg>1.5</caaml:avg>
          </caaml:Components>
        </caaml:grainSize>
        <caaml:hardness uom="N">F</caaml:hardness>
      </caaml:Layer>
      <caaml:Layer>
        <caaml:comment>occasional surface hoar forms</caaml:comment>
        <caaml:depthTop uom="cm">6</caaml:depthTop>
        <caaml:thickness uom="cm">1</caaml:thickness>
        <caaml:grainFormPrimary>SH</caaml:grainFormPrimary>
        <caaml:grainFormSecondary>FC</caaml:grainFormSecondary>
        <caaml:grainSize uom="mm">
          <caaml:Components>
            <caaml:avg>1</caaml:avg>
            <caaml:avgMax>5</caaml:avgMax>
          </caaml:Components>
        </caaml:grainSize>
        <caaml:hardness uom="N">4F</caaml:hardness>
      </caaml:Layer>
      <caaml:Layer>
        <caaml:depthTop uom="cm">7</caaml:depthTop>
        <caaml:thickness uom="cm">9</caaml:thickness>
        <caaml:grainFormPrimary>FC</caaml:grainFormPrimary>
        <caaml:grainFormSecondary>RGxf</caaml:grainFormSecondary>
        <caaml:grainSize uom="mm">
          <caaml:Components>
            <caaml:avg>0.5</caaml:avg>
            <caaml:avgMax>1</caaml:avgMax>
          </caaml:Components>
        </caaml:grainSize>
        <caaml:hardness uom="N">4F</caaml:hardness>
      </caaml:Layer>
      <caaml:Layer>
        <caaml:comment>melted surface hoar</caaml:comment>
        <caaml:depthTop uom="cm">16</caaml:depthTop>
        <caaml:thickness uom="cm">1</caaml:thickness>
        <caaml:grainFormPrimary>SHxr</caaml:grainFormPrimary>
        <caaml:grainFormSecondary>RG</caaml:grainFormSecondary>
        <caaml:grainSize uom="mm">
          <caaml:Components>
            <caaml:avg>1</caaml:avg>
            <caaml:avgMax>3</caaml:avgMax>
          </caaml:Components>
        </caaml:grainSize>
        <caaml:hardness uom="N">4F</caaml:hardness>
      </caaml:Layer>
      <caaml:Layer>
        <caaml:depthTop uom="cm">17</caaml:depthTop>
        <caaml:thickness uom="cm">10</caaml:thickness>
        <caaml:grainFormPrimary>FC</caaml:grainFormPrimary>
        <caaml:grainFormSecondary>RG</caaml:grainFormSecondary>
        <caaml:grainSize uom="mm">
          <caaml:Components>
            <caaml:avg>1</caaml:avg>
          </caaml:Components>
        </caaml:grainSize>
        <caaml:hardness uom="N">1F</caaml:hardness>
      </caaml:Layer>
      <caaml:Layer>
        <caaml:depthTop uom="cm">27</caaml:depthTop>
        <caaml:thickness uom="cm">4</caaml:thickness>
        <caaml:grainFormPrimary>FC</caaml:grainFormPrimary>
        <caaml:grainFormSecondary>RGxf</caaml:grainFormSecondary>
        <caaml:grainSize uom="mm">
          <caaml:Components>
            <caaml:avg>0.5</caaml:avg>
            <caaml:avgMax>1</caaml:avgMax>
          </caaml:Components>
        </caaml:grainSize>
        <caaml:hardness uom="N">1F</caaml:hardness>
      </caaml:Layer>
      <caaml:Layer>
        <caaml:depthTop uom="cm">31</caaml:depthTop>
        <caaml:thickness uom="cm">4</caaml:thickness>
        <caaml:grainFormPrimary>FC</caaml:grainFormPrimary>
        <caaml:grainFormSecondary>RGxf</caaml:grainFormSecondary>
        <caaml:grainSize uom="mm">
          <caaml:Components>
            <caaml:avg>1</caaml:avg>
            <caaml:avgMax>1.5</caaml:avgMax>
          </caaml:Components>
        </caaml:grainSize>
        <caaml:hardness uom="N">1F</caaml:hardness>
      </caaml:Layer>
      <caaml:Layer>
        <caaml:depthTop uom="cm">35</caaml:depthTop>
        <caaml:thickness uom="cm">7</caaml:thickness>
        <caaml:grainFormPrimary>MFpc</caaml:grainFormPrimary>
        <caaml:grainSize uom="mm">
          <caaml:Components>
            <caaml:avg>6</caaml:avg>
            <caaml:avgMax>12</caaml:avgMax>
          </caaml:Components>
        </caaml:grainSize>
        <caaml:hardness uom="N">K</caaml:hardness>
      </caaml:Layer>
      <caaml:Layer>
        <caaml:comment>base of crust is uneven - some forms stuck together</caaml:comment>
        <caaml:depthTop uom="cm">42</caaml:depthTop>
        <caaml:thickness uom="cm">8</caaml:thickness>
        <caaml:grainFormPrimary>FC</caaml:grainFormPrimary>
        <caaml:grainFormSecondary>RGxf</caaml:grainFormSecondary>
        <caaml:grainSize uom="mm">
          <caaml:Components>
            <caaml:avg>1</caaml:avg>
            <caaml:avgMax>2</caaml:avgMax>
          </caaml:Components>
        </caaml:grainSize>
        <caaml:hardness uom="N">P</caaml:hardness>
      </caaml:Layer>
      <caaml:Layer>
        <caaml:depthTop uom="cm">50</caaml:depthTop>
        <caaml:thickness uom="cm">6</caaml:thickness>
        <caaml:grainFormPrimary>MFpc</caaml:grainFormPrimary>
        <caaml:grainSize uom="mm">
          <caaml:Components>
            <caaml:avg>2</caaml:avg>
            <caaml:avgMax>6</caaml:avgMax>
          </caaml:Components>
        </caaml:grainSize>
        <caaml:hardness uom="N">K-I</caaml:hardness>
      </caaml:Layer>
    </caaml:stratProfile>
    <caaml:tempProfile uomDepth="cm" uomTemp="degC">
      <caaml:Obs>
        <caaml:depth>0</caaml:depth>
        <caaml:snowTemp>-3.5</caaml:snowTemp>
